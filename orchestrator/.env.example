# .env に写して値を入れる。.env は .gitignore 済み。秘密情報は builder が自分で発行する。

# Claude Code の OAuth トークン（Max 契約）。builder の Mac で `claude setup-token` を実行して得る
CLAUDE_CODE_OAUTH_TOKEN=

# 工場の GitHub の身元（ADR 0041）。GitHub App（推奨）か fine-grained PAT のどちらか。両方あれば App を使う
# - GitHub App: 作り方は orchestrator/README.md の「GitHub App」。dispatcher がジョブごとにリポジトリと権限を絞った 1 時間のトークンを発行する
#   GH_APP_PRIVATE_KEY_B64 は App の秘密鍵の PEM を base64 で 1 行にしたもの（base64 < key.pem | tr -d '\n'）
GH_APP_ID=
GH_APP_PRIVATE_KEY_B64=
# GH_APP_INSTALLATION_ID=     # 任意。空なら FACTORY_REPOS の owner から引く
# - PAT（App が無いときだけ）: 対象リポジトリに Contents: Read/Write、Pull requests: Read/Write、Issues: Read/Write
GH_TOKEN=

# 対象リポジトリ（カンマ区切り）
FACTORY_REPOS=guccyon/rally

# 任意。Webhook を使うときだけ（未設定ならポーリングのみ）
WEBHOOK_SECRET=

# 任意。ジョブの DB の専用の利用者（factory_job）の合言葉。管理者ではなく、制御プレーンの DB には繋げない
# JOB_DB_PASSWORD=

# 知見の制限付きの保管先の利用者（factory_restricted）の合言葉はここに書かない。管理者の手元に置き、使うときだけ
# docker compose exec -e RESTRICTED_DATABASE_URL で渡す（ADR 0024 の 5、README の「Learn ループ」）

# 任意。工場の中での一次調査の、調査用の DB の利用者（factory_investigate。読み取り専用・investigate のビューだけ）への接続（ADR 0048）。
# 管理者が alter role factory_investigate login password '...' で有効にしてから書く。dispatcher だけが使い、ワーカーには渡さない。
# 書かなければ、調査役の SQL の道具は「DB は使えない」と返す（ログ・GitHub・定義で調べる）
# INVESTIGATE_DATABASE_URL=postgresql://factory_investigate:<合言葉>@postgres:5432/factory

# 任意。同時実行と予算の上書き
# MAX_PARALLEL=2
# MAX_TURNS=40
# TOKEN_BUDGET_PER_JOB=2000000
# MODEL_TIER=tier-large

# 任意。リポジトリごとのワーカーイメージ（Rust のツールチェーンが要るリポジトリ）。docker build -t factory-worker:rust -f worker/Dockerfile.rust worker
# WORKER_IMAGES=guccyon/rally=factory-worker:rust

# 任意。建設状況の日次レポート（ADR 0008）。健康レポートとペア比較の結果を数える建設作業フォルダ（Mac の 50_build-work/）
# BUILD_WORK_DIR=/path/to/50_build-work
# DAILY_REPORT_HOUR=5

# 任意。操業コンソール（ADR 0009）。既定は http://localhost:8790 で Mac の中だけ。閉じた網から開くときはそのホスト名を足す
# CONSOLE_HOST_PORT=8790
# CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1
# CONSOLE_OPERATOR=builder

# 任意。ランナーの窓口（ADR 0033）。Mac ランナーはホストで scripts/macrunner.sh install（工場の操業コンソールでペアリングを許可する）。
# 同じ LAN の別の Mac のランナーを足すときは 0.0.0.0。確かめるのは docker compose exec dispatcher factoryctl runner check
# RUNNER_GATE_BIND=127.0.0.1

# 任意。通知の出し分け（ADR 0032）で、製品の .factory-config/notifications.yaml の secret: env:NAME が指す値。名前は設定に合わせる
# SLACK_WEBHOOK_URL_PROVIDER=
# SLACK_WEBHOOK_URL_OWNER=
# SLACK_BOT_TOKEN_OWNER=                       # via: slack_app のボットのトークン（xoxb-…）。権限は chat:write・files:write・channels:read。定期レポートは報告書（HTML）を添付して送る

# 任意。工場の前段（ADR 0035）。工場をインターネットに置くとき（パイロットの EC2 など）だけ。手順は edge/README.md
# COMPOSE_FILE=compose.yaml:compose.edge.yaml
# EDGE_DOMAIN=factory.example.com              # console.・proto.・desk. の 3 つをこの下に置く
# EDGE_GITHUB_CLIENT_ID=                       # GitHub の OAuth App（callback は https://console.<EDGE_DOMAIN>/oauth2/callback）
# EDGE_GITHUB_CLIENT_SECRET=
# EDGE_COOKIE_SECRET=                          # python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# EDGE_GITHUB_USERS=                           # 通す GitHub アカウント（カンマ区切り）
# EDGE_ALLOW_CIDRS=0.0.0.0/0 ::/0              # 通す送信元（空白区切り）。セキュリティグループと同じ値に

# ENGINE_VERSION はここに書かない。scripts/build.sh がイメージに焼き込む（ADR 0031）。書いても使われない
